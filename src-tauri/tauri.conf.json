{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nguda",
  "version": "0.1.0",
  "identifier": "dev.nguda.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "nguda",
        "width": 420,
        "height": 280
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "nguda",
    "homepage": "https://github.com/purwa-astawa/nguda-app",
    "copyright": "Copyright © 2026 the nguda contributors",
    "license": "MIT OR Apache-2.0",
    "category": "Productivity",
    "shortDescription": "Tray-first planner and time tracker that shows your real estimate gap.",
    "longDescription": "nguda plans your day from local tasks and Google Calendar, tracks the running task from the status bar, helps you recover when you run over, and shows planned versus actual time so you learn how far your estimates are off.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1",
          "libwebkit2gtk-4.1-0"
        ],
        "desktopTemplate": "linux/nguda.desktop"
      },
      "rpm": {
        "depends": [
          "libayatana-appindicator-gtk3",
          "webkit2gtk4.1"
        ],
        "desktopTemplate": "linux/nguda.desktop"
      }
    }
  }
}
